#!/bin/sh
# Образ nginx выполняет *.envsh из /docker-entrypoint.d в своей оболочке до подстановки шаблонов,
# поэтому экспорт виден шаблону. Адрес API без завершающего слэша: proxy_pass с путём
# (http://host:8000/) заменил бы префикс /api/, и запрос /api/meta ушёл бы как /meta.
export API_URL="${API_URL%/}"
