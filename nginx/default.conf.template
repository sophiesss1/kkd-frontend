server {
    listen 80;
    root /usr/share/nginx/html;

    # Фронтенд обращается к API по относительному пути /api — адрес бэкенда задаётся переменной API_URL
    location /api/ {
        proxy_pass ${API_URL};
        proxy_set_header Host $host;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri /index.html;
    }
}
